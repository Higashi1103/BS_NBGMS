CREATE TABLE `gakusei` (
  `gakusei_id` int NOT NULL AUTO_INCREMENT,
  `kurasu_id` int NOT NULL,
  `namae` varchar(100) NOT NULL,
  `seibetsu` varchar(100) NOT NULL,
  `seinengappi` varchar(100) NOT NULL,
  `saishu_gakureki` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NOT NULL,
  `gogakuryoku` varchar(100) NOT NULL,
  `tensu` int NOT NULL,
  `hyouka` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci DEFAULT NULL,
  `sonota` varchar(100) DEFAULT NULL,
  `yobi1` varchar(100) DEFAULT NULL,
  `yobi2` varchar(100) DEFAULT NULL,
  `yobi3` varchar(100) DEFAULT NULL,
  `DELETE_FLAG` int NOT NULL,
  PRIMARY KEY (`gakusei_id`)
) ENGINE=InnoDB AUTO_INCREMENT=6 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
